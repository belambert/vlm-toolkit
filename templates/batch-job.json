{
  "taskGroups": [
    {
      "taskCount": "1",
      "parallelism": "1",
      "taskSpec": {
        "computeResource": {
          "cpuMilli": "{{CPU_MILLI}}",
          "memoryMib": "{{MEMORY_MIB}}",
          "bootDiskMib": "{{BOOT_DISK_MIB}}"
        },
        "runnables": [
          {
            "container": {
              "imageUri": "{{IMAGE_URI}}",
              "commands": {{{COMMANDS_JSON}}},
              "volumes": [],
              "options": "{{CONTAINER_OPTIONS}}"
            }
          }
        ],
        "volumes": {{{VOLUMES_JSON}}}
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        {{#HAS_GPU}}
        "installGpuDrivers": true,
        "policy": {
          "machineType": "{{MACHINE_TYPE}}",
          "accelerators": [
            {
              "type": "{{GPU_TYPE}}",
              "count": {{GPU_COUNT}}
            }
          ],
          "bootDisk": {
            "image": "batch-debian"
          }
        }
        {{/HAS_GPU}}
        {{^HAS_GPU}}
        "policy": {
          "machineType": "{{MACHINE_TYPE}}",
          "bootDisk": {
            "image": "batch-debian"
          }
        }
        {{/HAS_GPU}}
      }
    ]
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}
